{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-aegis",
  "version": "0.1.1",
  "identifier": "dev.claudeaegis.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "claude-aegis",
        "width": 1120,
        "height": 800,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
